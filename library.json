{
    "name": "roo_wifi",
    "description": "Portable Wi-Fi operations and known-key profiles, with an ESP32 ESP-IDF adapter.",
    "keywords": [
        "WiFi"
    ],
    "authors": [
        {
            "name": "Dejwk",
            "email": "dejwk.oss@gmail.com",
            "maintainer": true
        }
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/dejwk/roo_wifi"
    },
    "version": "2.0.0",
    "homepage": "https://github.com/dejwk/roo_wifi",
    "frameworks": [
        "Arduino",
        "espidf"
    ],
    "platforms": [
        "espressif32"
    ],
    "build": {
        "srcDir": "src",
        "srcFilter": "+<*> -<examples> -<benchmarks> -<doc> -<test>"
    },
    "dependencies": {
        "dejwk/roo_collections": ">=1.4.7",
        "dejwk/roo_prefs": ">=2.0.0",
        "dejwk/roo_backport": ">=1.2.4",
        "dejwk/roo_scheduler": ">=2.2.0"
    }
}